{
  "name": "node-red-contrib-mqtt-picker",
  "version": "0.0.1",
  "description": "A simple Node-RED node that provides a text field with a picker button to choose from hardcoded strings.",
  "keywords": ["node-red","node-red-node","string","picker"],
  "node-red": {
    "nodes": {
      "mqtt-db-subscriber": "nodes/subscriber.js",
      "mqtt-db-in": "nodes/in.js",
      "mqtt-db-call": "nodes/call.js",
      "mqtt-db-out": "nodes/out.js"
    }
  },
  "scripts": {
    "dev": "node ./scripts/dev-start.js",
    "test": "node nodes/db.test.js && node resources/mqtt-tree.test.js",
    "prepack": "echo 'Preparing package'"
  },
  "files": [
    "nodes/",
    "resources/treeview.js",
    "resources/treeview.css",
    "resources/mqtt-tree.js",
    "mqtt-picker1.jpg",
    "mqtt-picker2.jpg",
    "mqtt-picker3.jpg",
    "README.md",
    "LICENSE"
  ],
