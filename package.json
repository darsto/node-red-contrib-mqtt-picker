{
  "name": "node-red-contrib-mqtt-picker",
  "version": "0.0.1",
  "engines": { "node": ">=18" },
  "description": "JSON MQTT device cache and property picker with configurable Full Topic patterns.",
  "keywords": ["node-red","node-red-node","string","picker"],
  "node-red": {
    "nodes": {
      "mqtt-db-subscriber": "nodes/subscriber.js",
      "mqtt-db-in": "nodes/in.js",
      "mqtt-db-call": "nodes/call.js",
      "mqtt-db-out": "nodes/out.js"
    }
  },
  "scripts": {
    "predev": "npm run build",
    "dev": "node ./scripts/dev-start.js",
    "test": "npm run build && node --test src/*.test.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf .tsbuild && tsc && cp .tsbuild/db.js nodes/db.js && cp .tsbuild/mqtt-topic-parser.js .tsbuild/mqtt-tree.js resources/ && rm -rf .tsbuild"
  },
  "files": [
    "nodes/",
    "resources/treeview.js",
    "resources/treeview.css",
    "resources/mqtt-tree.js",
    "resources/mqtt-topic-parser.js",
    "mqtt-picker1.jpg",
    "mqtt-picker2.jpg",
    "mqtt-picker3.jpg",
    "README.md",
    "LICENSE"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "node-red": "^3.0.0",
    "typescript": "^5.9.3"
  }
}
